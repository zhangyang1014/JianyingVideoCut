{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "human_escalation.schema.json",
  "title": "HumanEscalation",
  "type": "object",
  "required": ["escalation_id", "mission_id", "triggered_by_agent", "urgency", "reason"],
  "properties": {
    "escalation_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "task_id": { "type": "string" },
    "triggered_by_agent": { "type": "string" },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "reason": { "type": "string" },
    "summary_for_human": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "blocked_actions": { "type": "array", "items": { "type": "string" } },
    "recommended_human_actions": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
